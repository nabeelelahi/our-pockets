# MongoDB Atlas connection string (free M0 cluster), including the database name.
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/our-pockets?retryWrites=true&w=majority
MONGODB_URI=

# Long random string used to sign session JWTs (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Public base URL of the app, used to build invitation links.
# Local: http://localhost:3000  Production: https://<your-project>.vercel.app
NEXT_PUBLIC_APP_URL=
